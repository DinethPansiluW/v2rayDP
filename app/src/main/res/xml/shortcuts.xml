<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_start_vpn"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_start"
        android:shortcutShortLabel="@string/start_service"
        android:shortcutLongLabel="@string/start_service">
        <intent
            android:action="com.example.v2raydp.ACTION_START_VPN"
            android:targetPackage="com.example"
            android:targetClass="com.example.ShortcutActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_stop_vpn"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_stop"
        android:shortcutShortLabel="@string/stop_service"
        android:shortcutLongLabel="@string/stop_service">
        <intent
            android:action="com.example.v2raydp.ACTION_STOP_VPN"
            android:targetPackage="com.example"
            android:targetClass="com.example.ShortcutActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_switch_profile"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_switch"
        android:shortcutShortLabel="@string/switch_profile"
        android:shortcutLongLabel="@string/switch_profile_long">
        <intent
            android:action="com.example.v2raydp.ACTION_SWITCH_PROFILE"
            android:targetPackage="com.example"
            android:targetClass="com.example.ShortcutActivity" />
    </shortcut>
</shortcuts>
